# Template only — Vite does NOT read this file.
# Copy it to `.env.local` and fill in the real values there:
#
#   cp .env.example .env.local
#
# Both values come from the Supabase dashboard:
#   URL -> Project Settings -> Data API (or build it from the Project ID:
#          https://<project-id>.supabase.co)
#   Key -> Project Settings -> API Keys -> the "anon" / "publishable" key
#
# Both are safe to ship in a browser bundle: row-level security is what
# protects the data, not the key. Never put the `service_role` key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The OpenAI key is NOT set here. Vite only exposes VITE_-prefixed variables,
# so putting it here would do nothing — and prefixing it VITE_ would bake it
# into the public JS bundle. It lives only as a Supabase Edge Function secret:
#   npx supabase secrets set OPENAI_API_KEY=sk-proj-...

# --- CareerCraft opportunities feed (both optional) ------------------------
# The RFPs view syncs scraped tenders from the CareerCraft public feed. It
# defaults to the live endpoint, so neither of these is normally needed.
#
# Override the endpoint (staging, or a local Next.js dev server):
# VITE_OPPORTUNITIES_API_URL=http://localhost:3000/api/public/opportunities
#
# Only required if OPPORTUNITIES_API_KEY has been set on the CareerCraft side.
# Note this is NOT a secret once built — anything in a Vite bundle is public.
# VITE_OPPORTUNITIES_API_KEY=
