# Copy to .env in this directory. Never commit the filled-in version.

# --- required ------------------------------------------------------------
# Supabase dashboard -> Settings -> Database -> Connection string -> Session
# pooler. Use the pooler, not the direct connection: the direct host is
# IPv6-only on most tiers and refuses connections from container networks with
# a message about the host being unreachable, which reads as a firewall problem
# and is not one.
AI_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Any long random string. Required before the API answers a single request.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_API_TOKEN=

# --- required only to read TOR files out of storage ----------------------
# Settings -> API. The service key bypasses row-level security, which is what
# lets this read a private bucket; it belongs in this file and nowhere else.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
AI_STORAGE_BUCKET=tenders

# --- optional, with the defaults shown -----------------------------------
AI_USE_EMBEDDINGS=true
AI_SPACY_MODEL=en_core_web_sm
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Capability score at or above which a tender is worth pursuing, and below
# which it is worth declining. Between them the answer is "consider".
AI_PURSUE_AT=50
AI_DECLINE_BELOW=25

AI_INTERVAL_SECONDS=900
AI_BATCH_SIZE=25

AI_HOST=127.0.0.1
AI_PORT=8099
# Empty means no browser may call this directly, which is the intent: the
# console reads analyses out of Postgres, not out of here.
AI_CORS_ORIGINS=
