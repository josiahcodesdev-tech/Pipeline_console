# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit these. `.env.example` is the safe template.
.env
.env.*
!.env.example

# Supabase CLI local state
supabase/.branches
supabase/.temp
supabase/.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Filled-in copies of migrations that carry secrets. Never commit these.
*.local.sql

# Local agent settings. Untracked because the permission allowlist records
# whole commands, and a command that carried a credential put a live Supabase
# token into a commit — GitHub's push protection caught it on the way out.
# Nothing in here is needed to build or run the console.
.claude/settings.json
.claude/settings.local.json
